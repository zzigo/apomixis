{
  "name": "apomixis-hylon",
  "private": true,
  "type": "module",
  "version": "0.8.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "viewer:serve": "node tools/apomixis-relay.mjs",
    "build": "vite build",
    "start": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "package:offline": "npm run build && node tools/package-offline.mjs",
    "build:klais": "python3 tools/build-klais.py --workers 4",
    "test:assets": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "package:klais": "npm run build && node tools/package-offline.mjs --with-klais",
    "check": "npm test && npm run test:assets && npm run check:spore && npm run build",
    "build:spore": "node tools/compile-spore.mjs",
    "check:spore": "node tools/compile-spore.mjs --check"
  },
  "dependencies": {
    "@tonejs/midi": "2.0.28",
    "dockview-core": "5.0.0",
    "vexflow": "4.2.5",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "vite": "7.3.8"
  }
}
